{
    "name": "lagdo/ui-builder-daisyui",
    "type": "library",
    "description": "UI Builder extensions for the DaisyUi framework.",
    "authors": [
        {
            "name": "Thierry Feuzeu",
            "email": "thierry.feuzeu@gmail.com"
        }
    ],
    "homepage": "https://github.com/lagdo/ui-builder-daisyui",
    "license": "MIT",
    "keywords": ["HTML", "UI Builder", "DaisyUi", "Tailwind CSS"],
    "support": {
        "issues": "https://github.com/lagdo/ui-builder-daisyui/issues",
        "source": "https://github.com/lagdo/ui-builder-daisyui"
    },
    "require": {
        "php": ">=8.1",
        "lagdo/ui-builder": "0.14.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "php-coveralls/php-coveralls": "^2.5",
        "phpunit/phpcov": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Lagdo\\UiBuilder\\DaisyUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lagdo\\UiBuilder\\DaisyUi\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
